# Copy to .env, then replace both password placeholders with the same local secret.
POSTGRES_USER=outreach
POSTGRES_PASSWORD=replace-with-local-password
POSTGRES_DB=outreach
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://outreach:replace-with-local-password@localhost:5432/outreach
ENVIRONMENT=development
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
BACKEND_PORT=8000

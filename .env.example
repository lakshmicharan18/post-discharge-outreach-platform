# Copy to .env, then replace both password placeholders with the same local secret.
POSTGRES_USER=outreach
POSTGRES_PASSWORD=replace-with-local-password
POSTGRES_DB=outreach
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://outreach:replace-with-local-password@localhost:5432/outreach
ENVIRONMENT=development
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
LLM_PROVIDER=deterministic
# LLM_PROVIDER=openai_compatible
# LLM_API_KEY=never-commit-this
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=provider-model-name
LLM_TIMEOUT_SECONDS=20
LLM_MAX_RETRIES=1
BACKEND_PORT=8000
